# SHWD 원본 (CLAUDE.md §3)
data/raw/*
!data/raw/.gitkeep

# 필터 통과분도 이미지라 무겁다 — 목록만 커밋한다
data/filtered/*
!data/filtered/.gitkeep

# 사전학습 가중치 — models/ 에 모은다. ultralytics 가 필요할 때 다시 내려받는다.
# 폴더 자체는 남긴다 — 없으면 내려받기가 실패한다
/models/*
!/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code — 사용자별 산출물 (훅이 생성)
.claude/logs/
.claude/analytics/
.claude/session.log
.claude/settings.local.json

# 노트북 실행 결과
.ipynb_checkpoints/

# 파인튜닝용 YOLO 변환본 (src/voc_to_yolo.py 가 재생성)
data/yolo/

# 학습 산출물 — 로그·플롯은 크고 재생성되므로 제외하되,
# 파인튜닝 가중치는 넣는다. 이게 없으면 clone 해도 수치가 재현되지 않는다
runs/*
!runs/detect/
runs/detect/*
!runs/detect/shwd_yolov8n/
runs/detect/shwd_yolov8n/*
!runs/detect/shwd_yolov8n/weights/
runs/detect/shwd_yolov8n/weights/*
!runs/detect/shwd_yolov8n/weights/best.pt
!runs/detect/shwd_yolov8n/results.csv
!runs/detect/shwd_yolov8n/args.yaml

# 검증 산출물 (커밋하지 않는다)
.playwright-mcp/

# 발표자료 생성물 — tools/ 가 outputs/*.json 에서 재생성한다.
# .pptx 는 배포 단위라 커밋하고, 그림·PDF·PNG 는 제외한다
outputs/figures/
outputs/*_전달용/

# 실행 로그와 검증 스크린샷 — 재생성되므로 추적하지 않는다
/logs/*
!/logs/.gitkeep
/docs/screenshots/
/*.png
/*.log
build/

# 선행연구 원문 PDF — 출판사 저작물이므로 올리지 않는다 (README.md 는 유지)
docs/reference/papers/*.pdf
# 본문 추출 텍스트도 같은 이유로 제외한다
docs/reference/papers/_*.txt

# 워드 잠금 파일 — 문서를 열어두면 생긴다
outputs/~$*
